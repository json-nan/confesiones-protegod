{
	{$CADDY_GLOBAL_OPTIONS}

	frankenphp {
		{$FRANKENPHP_CONFIG}
	}
}

{$CADDY_EXTRA_CONFIG}

# Defaults to plain HTTP on :80 so the image drops straight behind a reverse
# proxy. Set SERVER_NAME to a hostname (e.g. confesiones.example.com) to let
# Caddy obtain and renew a Let's Encrypt certificate on its own.
{$SERVER_NAME::80} {
	log {
		{$CADDY_SERVER_LOG_OPTIONS}
	}

	root * {$SERVER_ROOT:/app/public}
	encode zstd br gzip

	# Vite fingerprints these filenames, so they can be cached indefinitely.
	@vite_assets path /build/assets/*
	header @vite_assets Cache-Control "public, max-age=31536000, immutable"

	# Dotfiles are never part of the public tree; .well-known stays reachable
	# so ACME challenges still work when SERVER_NAME is a real hostname.
	@hidden {
		path /.*
		not path /.well-known/*
	}
	respond @hidden 404

	{$CADDY_SERVER_EXTRA_DIRECTIVES}

	php_server {
		index index.php
	}
}
