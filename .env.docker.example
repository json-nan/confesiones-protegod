# Runtime environment for the container image. Copy to a file the platform
# reads (or feed each line in as a secret) — it is never baked into the image.
#
#   cp .env.docker.example .env.docker
#   docker run --env-file .env.docker -p 8080:80 confesiones

APP_NAME="Confesiones"
APP_ENV=production
APP_DEBUG=false
APP_TIMEZONE=UTC

# Generate once and keep it stable — rotating it invalidates every session
# and every encrypted value already in the database.
#   php artisan key:generate --show
APP_KEY=

# Must match the public URL exactly, scheme included.
APP_URL=https://confesiones.example.com

APP_LOCALE=es
APP_FALLBACK_LOCALE=en

LOG_CHANNEL=stack
LOG_STACK=single
LOG_LEVEL=warning

# --- Turso -----------------------------------------------------------------
# turso db show <database>        -> the HTTP URL
# turso db tokens create <database> -> the access token
DB_CONNECTION=turso
DB_URL=https://<database>-<org>.turso.io
DB_ACCESS_TOKEN=

# Raise these if the container sits far from the Turso region — the defaults
# are 2s to connect and 5s per query, and every query is one HTTP request.
TURSO_CONNECT_TIMEOUT=5
TURSO_REQUEST_TIMEOUT=15

# --- Drivers ---------------------------------------------------------------
# Every Turso query is an HTTP round trip, so sessions and cache stay on local
# disk instead of adding two round trips to each request. Trade-off: sessions
# live inside the container and are dropped on redeploy (users log in again),
# and this only holds for a single container. Running more than one replica
# means moving SESSION_DRIVER to redis (or back to database).
SESSION_DRIVER=file
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

CACHE_STORE=file
CACHE_PREFIX=

# No queued jobs exist in this app, so jobs run inline and no worker is needed.
QUEUE_CONNECTION=sync
BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local

MAIL_MAILER=log
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

# --- Container -------------------------------------------------------------
# ':80' serves plain HTTP for a reverse proxy to terminate TLS in front of.
# Set a hostname instead (confesiones.example.com) to have Caddy request and
# renew its own Let's Encrypt certificate — that also needs port 443 published
# and a persistent volume on /data.
SERVER_NAME=:80

# Required for correct https:// URLs when a proxy terminates TLS. Use '*' only
# when the container is unreachable except through that proxy.
TRUSTED_PROXIES=*

# Migrations run on boot. Set to false when running more than one container
# and apply them as a separate release step instead.
RUN_MIGRATIONS=true
